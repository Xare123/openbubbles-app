<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/facetime_viewer_canvas"
    android:keepScreenOn="true"
    tools:context=".services.facetime.FaceTimeActivity">

    <LinearLayout
        android:id="@+id/viewerSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/callHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:accessibilityLiveRegion="polite"
                android:text="@string/facetime_viewer_joining"
                android:textColor="@color/facetime_viewer_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/main_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/facetime_viewer_canvas"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/nativeCallControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="8dp"
            android:background="@drawable/facetime_viewer_dock"
            android:padding="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/endCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="112dp"
                android:minHeight="56dp"
                android:background="@drawable/facetime_viewer_end"
                android:backgroundTint="@null"
                android:fontFamily="sans-serif-medium"
                android:drawableStart="@drawable/call_end"
                android:drawablePadding="8dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:contentDescription="@string/facetime_viewer_end_description"
                android:text="@string/facetime_viewer_end"
                android:textAllCaps="false"
                android:textColor="@color/facetime_viewer_primary"
                android:textSize="17sp" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/splashLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <ImageView
            android:id="@+id/posterView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:src="@tools:sample/backgrounds/scenic" />

        <LinearLayout
            android:id="@+id/callDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                app:shapeAppearanceOverlay="@style/roundedImageViewRounded"
                android:id="@+id/avatarView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginBottom="15dp"
                android:src="@mipmap/person64" />

            <TextView
                android:id="@+id/callTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:text="+188877774444"
                android:textColor="#ffffffff"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/loadingBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Incoming FaceTime Call"
                android:textColor="#ffffffff" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/acceptButtons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="60dp"
            android:layout_marginRight="60dp"
            android:layout_marginBottom="70dp"
            android:gravity="bottom"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/reject"
                    android:layout_width="70dp"
                    android:layout_height="70dp"

                    android:background="@drawable/reject_call_bg"
                    android:outlineProvider="none"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/call_end" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Decline"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/accept"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/accept_call_bg"
                    android:outlineProvider="none"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/accept" />

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Accept"
                    android:textColor="@android:color/white" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
